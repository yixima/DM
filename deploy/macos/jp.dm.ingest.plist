<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.dm.ingest</string>

  <!-- バウンス・配信停止の取り込み。毎日回すこと。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DM_ROOT__/scripts/periodic_run.sh</string>
    <string>ingest</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__DM_ROOT__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__DM_ROOT__/state/logs/launchd-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>__DM_ROOT__/state/logs/launchd-ingest.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DM_PYTHON</key>
    <string>__DM_ROOT__/.venv/bin/python</string>
  </dict>
</dict>
</plist>
