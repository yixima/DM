# ---- 送信者情報（法令上必須。ここを埋めないと送信は fail-closed で止まります）----
DM_SENDER_NAME="株式会社サンプル"
DM_SENDER_PERSON="営業部 山田 太郎"
DM_SENDER_EMAIL="info@example.co.jp"
DM_SENDER_REPLY_TO="info@example.co.jp"
DM_SENDER_PHONE="03-0000-0000"
DM_SENDER_ADDRESS="〒100-0001 東京都千代田区千代田1-1-1 サンプルビル5F"
DM_SENDER_URL="https://example.co.jp/"

# ---- 配信停止（特定電子メール法：オプトアウトの明示が必須）----
DM_UNSUBSCRIBE_BASE_URL="https://example.co.jp/unsubscribe"
DM_UNSUBSCRIBE_EMAIL="unsubscribe@example.co.jp"
DM_UNSUBSCRIBE_SECRET="change-me-to-a-long-random-string"

# ---- SMTP ----
DM_SMTP_HOST="smtp.example.co.jp"
DM_SMTP_PORT="587"
DM_SMTP_USER="info@example.co.jp"
DM_SMTP_PASSWORD=""
DM_SMTP_STARTTLS="true"

# ---- 受信箱スキャン（バウンス・配信停止の取り込み。任意）----
DM_IMAP_HOST="imap.example.co.jp"
DM_IMAP_PORT="993"
DM_IMAP_USER="info@example.co.jp"
DM_IMAP_PASSWORD=""

# ---- 問い合わせフォーム入力用プロフィール（未設定なら DM_SENDER_* から補完）----
DM_FORM_COMPANY="株式会社サンプル"
DM_FORM_PERSON_SEI="山田"
DM_FORM_PERSON_MEI="太郎"
DM_FORM_KANA_SEI="ヤマダ"
DM_FORM_KANA_MEI="タロウ"
DM_FORM_DEPARTMENT="営業部"
DM_FORM_EMAIL="info@example.co.jp"
DM_FORM_PHONE="03-0000-0000"
DM_FORM_ZIP="100-0001"
DM_FORM_PREFECTURE="東京都"
DM_FORM_ADDRESS="東京都千代田区千代田1-1-1 サンプルビル5F"
DM_FORM_URL="https://example.co.jp/"
